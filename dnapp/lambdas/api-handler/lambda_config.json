{
  "version": "1.0",
  "name": "api-handler",
  "func_name": "APIHandler::APIHandler.Function::FunctionHandler",
  "resource_type": "lambda",
  "iam_role_name": "api-handler-role",
  "runtime": "dotnet10",
  "memory": 128,
  "timeout": 100,
  "lambda_path": "lambdas\\api-handler",
  "dependencies": [],
  "event_sources": [],
  "env_variables": {
    "COGNITO_USER_POOL_ID": {
      "resource_name": "${user_pool_name}",
      "resource_type": "cognito_idp",
      "parameter": "id"
    },
    "COGNITO_USER_POOL_CLIENT_ID": {
      "resource_name": "${user_pool_name}",
      "resource_type": "cognito_idp",
      "parameter": "client_id"
    },
    "reports_queue_name": "${reports_queue_name}",
    "OrderIndexReservationId": "${orders_index_reservationid}",
    "REGION": "${region}",
    "notificationsTable": "${notifications_table_name}",
    "FEEDBACK_TABLE_NAME": "${feedback_table_name}",
    "locationsTable": "${locations-table}",
    "WaiterListTableName": "${waiter_list_table_name}",
    "tablesTable": "${tables_table}",
    "dishesTable": "${dishes-table}",
    "reservationsTable": "${reservations-table}",
    "reportsTable": "${reports_table_name}",
    "reportsHistoryTable": "${reports_history_table_name}",
    "profileImagesTable": "${profile_images_table_name}",
    "notificationsUserIdIndex": "${notifications_userId-global-index}",
    "reservationsCustomerIdGlobalIndex": "${reservations-customerId-global-index}",
    "reservationsWaiterIdGlobalIndex": "${reservations-waiterId-global-index}",
    "reservationsTableGlobalIndex": "${reservations-table-global-index}",
    "waitersGlobalIndex": "${waiters_global_index}",
    "imagesBucketName": "${imagesBucketName}",
    "profileImagesBucketName": "${profileImagesBucketName}",
    "ordersTable": "${orders-table}",
    "feedbackGlobalIndex": "${feedback_global_index}",
    "groupReservationsTable": "GroupReservations",
    "guestSessionTable": "GuestSessions",
    "tableLocationIdIndex": "${tables-locationId-global-index}"
  },
  "publish_version": true,
  "alias": "${lambdas_alias_name}",
  "logs_expiration": "${logs_expiration}",
  "url_config": {},
  "ephemeral_storage": 512,
  "tags": {}
}